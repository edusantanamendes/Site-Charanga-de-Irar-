# Copie para .env. Nunca versione credenciais reais.
NODE_ENV=development
PORT=3001
SITE_URL=http://localhost:3000
# Em desenvolvimento, npm run dev inicia PostgreSQL embutido se esta variável ficar vazia.
# Em produção, PostgreSQL gerenciado/servidor é obrigatório.
DATABASE_URL=
# Gere: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Quantidade de proxies confiáveis: 0 direto, 1 somente atrás de um proxy confiável.
TRUST_PROXY=0
UPLOAD_DIR=./uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# O destinatário oficial é configurado no painel, em Configurações.
